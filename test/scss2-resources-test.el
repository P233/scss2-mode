(require 'ert)
(require 'scss2-mode)

(defun scss2-resources-test--fontify ()
  "Enable real JIT fontification in the current test buffer."
  (rename-buffer "scss2-resources-test" t)
  (let ((noninteractive nil)) (font-lock-mode 1))
  (font-lock-ensure))

(defun scss2-resources-test--faces ()
  "Return the current accessible characters' faces."
  (cl-loop for position from (point-min) below (point-max)
           collect (get-text-property position 'face)))

(ert-deftest scss2-resources-release-preserves-document-and-highlighting ()
  (dolist (mode '(css2-mode scss2-mode))
    (dolist (scss2-fontify-details '(nil t))
      (with-temp-buffer
        (insert ".card { --url: http://example.test/a; color: red; /* note */ margin: 2px; }")
        (let ((css-fontify-colors nil)) (funcall mode))
        (scss2-resources-test--fontify)
        (buffer-enable-undo)
        (goto-char (point-min)) (insert "/* unsaved */ ") (undo-boundary)
        (font-lock-ensure)
        (with-silent-modifications
          (add-text-properties 2 8 '(help-echo "Keep me" read-only t custom-tag kept)))
        (let ((faces (scss2-resources-test--faces))
              (text (buffer-substring-no-properties (point-min) (point-max)))
              (tick (buffer-chars-modified-tick)) (history buffer-undo-list)
              (parser (car (treesit-parser-list))) (query (scss2--query '((raw_text) @raw)))
              (root (scss2--root-node))
              (parse (symbol-function 'treesit-parser-root-node)) ranges)
          (narrow-to-region 2 (1- (point-max)))
          (goto-char 5) (set-mark 7) (setq mark-active t)
          (cl-letf (((symbol-function 'treesit-parser-root-node)
                     (lambda (target)
                       (push (treesit-parser-included-ranges target) ranges)
                       (funcall parse target))))
            (should (scss2--release-buffer-resources)))
          (should (equal ranges '(((1 . 1)))))
          (should (treesit-node-check root 'outdated))
          (should (eq parser (car (treesit-parser-list))))
          (should (eq query (scss2--query '((raw_text) @raw))))
          (should-not (treesit-parser-included-ranges parser))
          (should (= (point-min) 2)) (should (= (point-max) (length text)))
          (should (= (point) 5)) (should (= (mark) 7)) (should mark-active)
          (should (buffer-modified-p))
          (should (= tick (buffer-chars-modified-tick)))
          (should (eq history buffer-undo-list))
          (should (equal (get-text-property 3 'help-echo) "Keep me"))
          (should (get-text-property 3 'read-only))
          (should (eq (get-text-property 3 'custom-tag) 'kept))
          (widen)
          (should (equal text (buffer-substring-no-properties (point-min) (point-max))))
          (should-not (text-property-not-all (point-min) (point-max) 'face nil))
          (font-lock-ensure)
          (should (equal faces (scss2-resources-test--faces)))
          (goto-char (point-min)) (search-forward "http://")
          (should-not (nth 4 (syntax-ppss)))
          (should (eq parser (car (treesit-parser-list))))
          (let ((inhibit-read-only t)) (undo-only 1))
          (should (string-prefix-p ".card" (buffer-string))))))))

(ert-deftest scss2-resources-native-consumers-rebuild-from-unsaved-text ()
  (with-temp-buffer
    (insert "$token: red; .card { color: $token; }")
    (scss2-mode)
    (let ((parser (car (treesit-parser-list)))
          (language scss2--parser-language))
      (dotimes (_ 3)
        (scss2--root-node)
        (should (scss2--release-buffer-resources))
        (goto-char (point-min)) (insert "$new: blue; ")
        ;; Native and built-in consumers have no package-specific resume hook.
        (should (= (treesit-node-end (treesit-buffer-root-node language)) (point-max)))
        (should (funcall imenu-create-index-function))
        (goto-char (point-max))
        (should (member "$new" (scss2-completion--names '("variable_declaration") t)))
        (should (member "$token" (scss2-completion--names '("variable_declaration") t)))
        (should (eq parser (car (treesit-parser-list))))))))

(ert-deftest scss2-resources-release-keeps-color-previews-and-structural-undo ()
  (dolist (mode '(css2-mode scss2-mode))
    (with-temp-buffer
      (insert ".a { color: #ff0000; margin: 1px 2px; }")
      (let ((css-fontify-colors t)) (funcall mode))
      (scss2-resources-test--fontify)
      (buffer-enable-undo)
      (set-buffer-modified-p nil)
      (let ((faces (scss2-resources-test--faces)))
        (should (scss2--release-buffer-resources))
        (should-not (buffer-modified-p))
        (font-lock-ensure)
        (should (equal faces (scss2-resources-test--faces))))
      (should (scss2--release-buffer-resources))
      (goto-char (point-min)) (search-forward "2px") (backward-char)
      (scss2-kill-value-item)
      (should (equal (buffer-string) ".a { color: #ff0000; margin: 1px; }"))
      (undo-boundary) (undo-only 1)
      (should (equal (buffer-string) ".a { color: #ff0000; margin: 1px 2px; }")))))

(ert-deftest scss2-resources-release-restores-ranges-after-error-or-quit ()
  (dolist (condition '(error quit))
    (with-temp-buffer
      (insert ".card { color: red; }") (scss2-mode)
      (let ((parser (car (treesit-parser-list))) caught)
        (scss2--root-node)
        (cl-letf (((symbol-function 'treesit-parser-root-node)
                   (lambda (_) (signal condition '("Resource test")))))
          (condition-case err
              (scss2--release-buffer-resources)
            ((error quit) (setq caught (car err)))))
        (should (eq caught condition))
        (should-not (treesit-parser-included-ranges parser))
        (should (= (treesit-node-end (scss2--root-node)) (point-max)))))))

(ert-deftest scss2-resources-keeps-custom-parser-clients ()
  (dolist (client '(notifier ranges second-parser))
    (with-temp-buffer
      (insert ".card { color: red; }") (scss2-mode)
      (scss2-resources-test--fontify)
      (let ((parser (car (treesit-parser-list)))
            (faces (scss2-resources-test--faces)))
        ;; The mode's own change notifier does not block release; others do.
        (should (memq #'scss2--mark-changed-ranges (treesit-parser-notifiers parser)))
        (pcase client
          ('notifier (treesit-parser-add-notifier parser #'ignore))
          ('ranges (treesit-parser-set-included-ranges parser (list (cons 1 (point-max)))))
          ('second-parser (treesit-parser-create (scss2-grammar-ensure 'css))))
        (should-not (scss2--release-buffer-resources))
        (should (equal faces (scss2-resources-test--faces)))))))

(defun scss2-resources-test--has-fontified-property ()
  "Whether any accessible text carries a `fontified' property, even nil."
  (let ((position (point-min)) found)
    (while (and (not found) (< position (point-max)))
      (setq found (plist-member (text-properties-at position) 'fontified)
            position (next-property-change position nil (point-max))))
    found))

(ert-deftest scss2-resources-change-marking-is-registered-once ()
  (with-temp-buffer
    (insert ".a { color: red; }")
    (dolist (mode '(scss2-mode css2-mode scss2-mode))
      (funcall mode)
      (should (equal (treesit-parser-notifiers (car (treesit-parser-list)))
                     '(scss2--mark-changed-ranges))))
    (scss2-syntax-setup 'scss)
    (should (equal (treesit-parser-notifiers (car (treesit-parser-list)))
                   '(scss2--mark-changed-ranges)))
    (should (= (cl-count #'scss2--extend-to-changed-start
                         syntax-propertize-extend-region-functions)
               1))))

(ert-deftest scss2-resources-release-reparses-mark-nothing ()
  ;; Emptying and rebuilding the tree report the whole buffer as changed.
  (dolist (mode '(css2-mode scss2-mode))
    (with-temp-buffer
      (insert ".card { color: red; }\n.title { margin: 0 2px; }\n")
      (funcall mode)
      (scss2-resources-test--fontify)
      (syntax-ppss (point-max))
      (should (scss2--release-buffer-resources))
      (let ((propertize syntax-propertize-function) starts)
        (setq-local syntax-propertize-function
                    (lambda (start end) (push start starts) (funcall propertize start end)))
        (should-not (scss2-resources-test--has-fontified-property))
        (should (= (treesit-node-end (scss2--root-node)) (point-max)))
        (should-not (scss2-resources-test--has-fontified-property))
        ;; The next edit propertizes from its own line, not from the start of the buffer.
        (goto-char (point-max)) (forward-line -1) (search-forward "margin") (insert " ")
        (let ((line (line-beginning-position)))
          (syntax-ppss (point-max))
          (should starts)
          (should (>= (apply #'min starts) line)))))))

(ert-deftest scss2-resources-idle-keeps-visible-completing-and-shared-buffers ()
  (save-window-excursion
    (delete-other-windows)
    (let ((buffers (cl-loop repeat 5 collect (generate-new-buffer "scss2-idle-test")))
          (release (symbol-function 'scss2--release-buffer-resources))
          clone released)
      (unwind-protect
          (progn
            (dolist (buffer buffers)
              (with-current-buffer buffer (insert ".a { color: red; }") (scss2-mode)))
            (set-window-buffer (selected-window) (nth 0 buffers))
            (set-window-buffer (split-window) (nth 1 buffers))
            (with-current-buffer (nth 2 buffers)
              (setq-local completion-in-region-mode t))
            (with-current-buffer (nth 3 buffers)
              (setq clone (clone-indirect-buffer "scss2-indirect-test" nil)))
            (cl-letf (((symbol-function 'input-pending-p) (lambda () nil))
                      ((symbol-function 'scss2--release-buffer-resources)
                       (lambda () (push (current-buffer) released) (funcall release))))
              (scss2--release-idle-buffers))
            (should (equal (seq-intersection released (cons clone buffers))
                           (list (nth 4 buffers)))))
        (when (buffer-live-p clone) (kill-buffer clone))
        (mapc #'kill-buffer buffers)))))

(ert-deftest scss2-resources-idle-yields-to-input ()
  (let ((buffers (cl-loop repeat 2 collect (generate-new-buffer "scss2-idle-input-test")))
        (release (symbol-function 'scss2--release-buffer-resources)) (calls 0))
    (unwind-protect
        (progn
          (dolist (buffer buffers)
            (with-current-buffer buffer (insert ".a {}") (scss2-mode)))
          (cl-letf (((symbol-function 'buffer-list) (lambda (&optional _) buffers))
                    ((symbol-function 'input-pending-p) (lambda () (> calls 0)))
                    ((symbol-function 'scss2--release-buffer-resources)
                     (lambda () (cl-incf calls) (funcall release))))
            (scss2--release-idle-buffers))
          (should (= calls 1)))
      (mapc #'kill-buffer buffers))))

(ert-deftest scss2-resources-timer-is-shared-and-stops-without-buffers ()
  (let ((scss2--idle-release-timer nil)
        (scss2-idle-release-delay 30)
        (buffers (cl-loop repeat 2 collect (generate-new-buffer "scss2-timer-test"))))
    (unwind-protect
        (progn
          (with-current-buffer (car buffers) (scss2-mode))
          (let ((timer scss2--idle-release-timer))
            (should (timerp timer))
            (with-current-buffer (cadr buffers) (scss2-mode))
            (should (eq timer scss2--idle-release-timer))
            (should (memq timer timer-idle-list))
            (mapc #'kill-buffer buffers)
            (cl-letf (((symbol-function 'buffer-list) (lambda (&optional _) nil)))
              (scss2--release-idle-buffers))
            (should-not scss2--idle-release-timer)
            (should-not (memq timer timer-idle-list)))
          (let ((scss2-idle-release-delay nil))
            (with-temp-buffer (scss2-mode))
            (should-not scss2--idle-release-timer)))
      (scss2-syntax-unload-function)
      (dolist (buffer buffers) (when (buffer-live-p buffer) (kill-buffer buffer))))))

