(require 'ert)
(require 'scss2-mode)

(ert-deftest scss2-performance-emmet-probe-and-live-table-share-context ()
  (dolist (mode '(css2-mode scss2-mode))
    (with-temp-buffer
      (insert ".a { m }")
      (funcall mode) (goto-char (- (point-max) 2))
      (let ((table (nth 2 (scss2-completion-at-point)))
            (analyze (symbol-function 'scss2-context-at-point)) (calls 0))
        (should (all-completions "m" table))
        (cl-letf (((symbol-function 'scss2-context-at-point)
                   (lambda () (cl-incf calls) (funcall analyze))))
          (dolist (event '(?a ?r delete delete))
            (if (eq event 'delete) (delete-char -1) (insert event))
            (setq calls 0)
            ;; Corfu probes the dispatcher before querying its existing table.
            (let* ((probe (scss2-completion-at-point))
                   (input (buffer-substring-no-properties (car probe) (cadr probe))))
              (should probe)
              (should (all-completions input table))
              (should (all-completions input table))
              (should (= calls 1)))))))))

(ert-deftest scss2-performance-contextual-fontification-reuses-compiled-query ()
  (with-temp-buffer
    (rename-buffer "scss2-contextual-query-test" t)
    (insert "$x: a; $m: (foo/**/#{$x}: red, bar/* note */#{$x}: blue);")
    (let ((scss2-fontify-colors nil)) (scss2-mode))
    (let ((noninteractive nil)) (font-lock-mode 1))
    (font-lock-ensure)
    (let ((capture (symbol-function 'treesit-query-capture))
          (compile (symbol-function 'treesit-query-compile)) (compilations 0) queries)
      (cl-letf (((symbol-function 'treesit-query-capture)
                 (lambda (node query &rest args)
                   (should-not (or (consp query) (stringp query)))
                   (push query queries)
                   (apply capture node query args)))
                ((symbol-function 'treesit-query-compile)
                 (lambda (&rest args) (cl-incf compilations) (apply compile args))))
        (dotimes (_ 3)
          (goto-char (point-min)) (search-forward "foo")
          (delete-char -1) (insert "o")
          (run-hook-with-args 'pre-redisplay-functions nil)
          (font-lock-ensure)))
      (should queries)
      (should (zerop compilations)))
    (goto-char (point-min)) (search-forward "foo")
    (should (eq (get-text-property (match-beginning 0) 'face) 'scss2-property))
    (search-forward "/**/")
    (should (eq (get-text-property (match-beginning 0) 'face) 'font-lock-comment-face))
    (search-forward "$x")
    (should (eq (get-text-property (match-beginning 0) 'face) 'font-lock-variable-name-face))))

(ert-deftest scss2-performance-semantic-admission-defers-candidate-collection ()
  ;; Frontends probe the dispatcher on every key; a module is read only when queried.
  (let ((directory (make-temp-file "scss2-admission-" t)))
    (unwind-protect
        (progn
          (with-temp-file (expand-file-name "_tokens.scss" directory) (insert "$token: red;"))
          (dolist (source '("$token: red; .a { color: $to }"
                            "@use 'tokens'; .a { color: tokens.$to }"))
            (with-temp-buffer
              (insert source) (backward-char 2)
              (setq buffer-file-name (expand-file-name "main.scss" directory))
              (let ((position (point))) (scss2-mode) (goto-char position))
              (let ((collect (symbol-function 'scss2-completion--candidates)) (calls 0) data)
                (cl-letf (((symbol-function 'scss2-completion--candidates)
                           (lambda (&rest args) (cl-incf calls) (apply collect args))))
                  (dotimes (_ 3) (setq data (scss2-completion-at-point)))
                  (should (zerop calls))
                  (completion-metadata "$to" (nth 2 data) nil)
                  (should (zerop calls))
                  (should (member "$token" (all-completions "$to" (nth 2 data))))
                  (should (member "$token" (all-completions "$to" (nth 2 data))))
                  (should (= calls 1))))
              (set-buffer-modified-p nil))))
      (delete-directory directory t))))

(ert-deftest scss2-performance-compiled-queries-still-read-edited-definitions ()
  (with-temp-buffer
    (insert "$one: red; .a { color: $ }")
    (scss2-mode) (goto-char (point-max))
    (should (equal (scss2-completion--names '("variable_declaration") t) '("$one")))
    (let ((compile (symbol-function 'treesit-query-compile)) (calls 0))
      (cl-letf (((symbol-function 'treesit-query-compile)
                 (lambda (&rest args) (cl-incf calls) (apply compile args))))
        (goto-char (point-min)) (insert "$two: blue; ") (goto-char (point-max))
        (should (equal (sort (scss2-completion--names '("variable_declaration") t) #'string<)
                       '("$one" "$two")))
        (should (zerop calls))))))

(defun scss2-performance-test--eager-compilations ()
  "Return internal query compilations in a new buffer's setup and first use."
  (let ((compile (symbol-function 'treesit-query-compile)) (count 0))
    (with-temp-buffer
      (rename-buffer "scss2-session-query-test" t)
      (insert "$x: a; $m: (foo/**/#{$x}: red);\n.a { color: $ }")
      ;; Emacs 31 setup also eagerly compiles font-lock rule objects via its own cache.
      (cl-letf (((symbol-function 'treesit-query-compile)
                 (lambda (language query &optional eager)
                   (when (and eager (not (treesit-compiled-query-p query)))
                     (cl-incf count))
                   (funcall compile language query eager))))
        (let ((scss2-fontify-colors nil)) (scss2-mode))
        (let ((noninteractive nil)) (font-lock-mode 1))
        (font-lock-ensure)
        (goto-char (- (point-max) 2))
        (should (member "$x" (all-completions "$" (nth 2 (scss2-completion-at-point))))))
      (goto-char (point-min)) (search-forward "foo")
      (should (eq (get-text-property (match-beginning 0) 'face) 'scss2-property)))
    count))

(ert-deftest scss2-performance-new-buffers-reuse-session-queries ()
  (scss2-performance-test--eager-compilations)
  (should (zerop (scss2-performance-test--eager-compilations)))
  ;; Each buffer's fixed grammar identity still selects its own compiled query.
  (should (equal (mapcar (lambda (mode)
                           (with-temp-buffer
                             (funcall mode)
                             (treesit-query-language (scss2--query '((raw_text) @raw)))))
                         '(css2-mode scss2-mode))
                 (list (scss2-grammar-language 'css) (scss2-grammar-language 'scss)))))

(ert-deftest scss2-performance-css-data-loads-on-first-semantic-completion ()
  ;; Only a fresh process shows what loading the mode alone reads.
  (with-temp-buffer
    (let* ((program
            `(progn
               (setq load-path ',load-path load-prefer-newer ,load-prefer-newer)
               (require 'scss2-mode)
               (setq scss2-grammar-cache-directory ,scss2-grammar-cache-directory)
               (advice-add 'scss2-grammar--compile :override
                           (lambda (&rest _) (error "The suite's grammar cache was not reused")))
               (when (featurep 'emmet2-css-data)
                 (error "Loading scss2-mode also loaded Emmet's CSS data"))
               (with-temp-buffer
                 (insert ".a {\n  display: fl\n}")
                 (scss2-mode)
                 (goto-char (point-min))
                 (search-forward "fl")
                 (let ((candidates (all-completions "fl" (nth 2 (scss2-completion-at-point)))))
                   (unless (member "flex" candidates)
                     (error "Value completion did not offer flex: %S" candidates))))
               (unless (featurep 'emmet2-css-data)
                 (error "Value completion did not load Emmet's CSS data"))))
           (status
            (call-process (expand-file-name invocation-name invocation-directory)
                          nil t nil "-Q" "--batch" "--eval" (prin1-to-string program))))
      (ert-info ((buffer-string)) (should (eq status 0))))))

(ert-deftest scss2-performance-syntax-query-is-reused-after-edits ()
  (dolist (mode '(css2-mode scss2-mode))
    (with-temp-buffer
      (insert ".a { background: url(http://example.test/a); --endpoint: http://example.test/b; }")
      (funcall mode)
      (let ((capture (symbol-function 'treesit-query-capture)) queries)
        (cl-letf (((symbol-function 'treesit-query-capture)
                   (lambda (node query &rest args)
                     (push query queries)
                     (apply capture node query args))))
          (dotimes (_ 3)
            (goto-char (point-min)) (search-forward "example") (insert "x")
            (scss2--syntax-propertize (point-min) (point-max))))
        (should (= (length queries) 3))
        ;; A sexp/string query asks the native API to compile again on each edit.
        (should-not (or (consp (car queries)) (stringp (car queries))))
        (should (cl-every (lambda (query) (eq query (car queries))) queries))
        (should (eq (treesit-query-language (car queries)) (scss2--language))))
      (goto-char (point-min))
      (while (search-forward "http://" nil t)
        (should-not (nth 4 (syntax-ppss)))))))

(ert-deftest scss2-performance-wide-query-retains-context-after-edits ()
  (dolist (mode '(css2-mode scss2-mode))
    (with-temp-buffer
      ;; Batch mode and hidden buffers otherwise disable real JIT hooks.
      (rename-buffer "scss2-wide-query-test" t)
      (insert "@media (width " (apply #'concat (make-list 4096 "/**/ "))
              "> 1px) { .a { color: red; } }")
      (let ((scss2-fontify-colors nil))
        (funcall mode)
        (let ((noninteractive nil)) (font-lock-mode 1))
        (should (eq font-lock-ensure-function #'jit-lock-fontify-now))
        (font-lock-ensure)
        (should-not (treesit-node-check (scss2--root-node) 'has-error))
        (goto-char (point-min))
        (search-forward "width")
        (let ((start (match-beginning 0)))
          (should (eq (get-text-property start 'face) 'scss2-property))
          (replace-match "height" t t)
          (run-hook-with-args 'pre-redisplay-functions nil)
          (font-lock-ensure start (point))
          (should-not (treesit-node-check (scss2--root-node) 'has-error))
          (should (eq (get-text-property start 'face) 'scss2-property)))
        (search-forward "/**/")
        (should (eq (get-text-property (match-beginning 0) 'face)
                    'font-lock-comment-face))
        (search-forward "1px")
        (should (eq (get-text-property (match-beginning 0) 'face)
                    'font-lock-number-face))))))

