        (should (eq (scss2-mode-test--face "payload")
                    (if (string-search "\\" name) 'css-property 'font-lock-constant-face)))
        (should (eq (scss2-mode-test--face "value") 'font-lock-constant-face))))))

(ert-deftest scss2-mode-conditional-media-ranges-have-property-faces ()
