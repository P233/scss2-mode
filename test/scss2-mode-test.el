(require 'ert)
(require 'scss2-mode)

(defun scss2-mode-test--face (text &optional offset)
  "Return the face at OFFSET in the first exact occurrence of TEXT."
  (let ((case-fold-search nil))
    (save-excursion
      (goto-char (point-min))
      (search-forward text)
      (get-text-property (+ (match-beginning 0) (or offset 0)) 'face))))

(ert-deftest scss2-mode-compact-fontification-preserves-semantic-faces ()
  (dolist (mode '(css2-mode scss2-mode))
    (with-temp-buffer
      (insert "@media (width > 10px) { .card { margin: 2px; content: \"3 + 4\"; /* 5 + 6 */ } }")
      (let ((css-fontify-colors nil)
            (scss2-fontify-details nil))
        (funcall mode)
        (font-lock-ensure)
        (dolist (role '(("@media" . font-lock-keyword-face)
                        ("width" . css-property)
                        (".card" . css-selector)
                        ("margin" . css-property)
                        ("px" . font-lock-type-face)
                        ("3 + 4" . font-lock-string-face)
                        ("5 + 6" . font-lock-comment-face)))
          (ert-info ((format "%s: %s" mode (car role)))
            (should (eq (scss2-mode-test--face (car role)) (cdr role)))))
        (dolist (text '("(" ">" "10" "{" "2" ";"))
          (should-not (scss2-mode-test--face text)))
        (should-not (treesit-node-check (scss2--root-node) 'has-error))
        (should (= (length (treesit-parser-list)) 1))
        (goto-char (point-min)) (search-forward "marg")
        (should (eq (plist-get (scss2-context-at-point) :role) 'property))))))

(ert-deftest scss2-mode-compact-fontification-preserves-context-and-interpolation ()
  (with-temp-buffer
    (rename-buffer "scss2-compact-fontify-test" t)
    (insert "$x: a; $m: (foo/**/#{$x}: red); .a { color: $x; }")
    (let ((css-fontify-colors nil)
          (scss2-fontify-details nil))
      (scss2-mode)
      (let ((noninteractive nil)) (font-lock-mode 1))
      (font-lock-ensure)
      (dolist (role '(("foo" . css-property)
                      ("/**/" . font-lock-comment-face)
                      ("#{" . font-lock-escape-face)
                      ("$x" . font-lock-variable-name-face)
                      ("red" . font-lock-constant-face)))
        (should (eq (scss2-mode-test--face (car role)) (cdr role))))
      (goto-char (point-min)) (search-forward "foo") (insert "bar")
      (run-hook-with-args 'pre-redisplay-functions nil)
      (font-lock-ensure)
      (should (eq (scss2-mode-test--face "foobar") 'css-property))
      (should (eq (scss2-mode-test--face "#{") 'font-lock-escape-face))
      (should-not (treesit-node-check (scss2--root-node) 'has-error)))))

(ert-deftest scss2-mode-shares-one-parser-and-preserves-dialect ()
  (with-temp-buffer
    (insert ".a { color: red; }")
    (dolist (mode '(css2-mode scss2-mode css2-mode scss2-mode))
      (funcall mode)
      (should (= (length (treesit-parser-list)) 1))
      (should (eq (treesit-parser-language (car (treesit-parser-list)))
                  (scss2-grammar-language (if (eq mode 'css2-mode) 'css 'scss))))
      (should (eq scss2-dialect (if (eq mode 'css2-mode) 'css 'scss)))
      (should (equal comment-start (if (eq mode 'css2-mode) "/*" "// ")))
      (dolist (key '("C-c C-s" "C-c C-e"))
        (should (equal (key-binding (kbd key))
                       (lookup-key (if (eq mode 'css2-mode) css-mode-map scss-mode-map)
                                   (kbd key)))))
      (should (eq indent-line-function #'smie-indent-line)))
    (fundamental-mode)
    (should-not scss2-dialect)
    (should-not (treesit-parser-list))))

(ert-deftest scss2-mode-parser-language-is-fixed-at-setup ()
  (dolist (mode '(css2-mode scss2-mode))
    (with-temp-buffer
      (insert ".a { color: red; }")
      (funcall mode)
      ;; Reloading an upgraded package can change the bundled grammar identity.
      (let ((parser (car (treesit-parser-list)))
            (scss2-grammar--content-id (make-string 64 ?b)))
        (goto-char (point-min))
        (search-forward "col")
        (should (eq (plist-get (scss2-context-at-point) :role) 'property))
        (should (equal (treesit-parser-list) (list parser)))))))

(ert-deftest scss2-mode-css-literals-do-not-become-sass-expressions ()
  (with-temp-buffer
    (insert ".a { content: \"#{$name}\"; --raw: #{$name}; animation-name: true, not; }\n/* #{$name} */\n// silent")
    (let ((css-fontify-colors nil))
      (css2-mode)
      (font-lock-mode 1)
      (font-lock-ensure)
      (should-not (treesit-node-check (scss2--root-node) 'has-error))
      (should-not (treesit-query-capture (scss2--root-node)
                                        '((interpolation) @expression)))
      (should (eq (scss2-mode-test--face "\"#{$name}\"" 3)
                  'font-lock-string-face))
      (should (eq (scss2-mode-test--face "--raw: #{$name}" 9)
                  'font-lock-string-face))
      (should (eq (scss2-mode-test--face "/* #{$name} */" 5)
                  'font-lock-comment-face))
      (should (eq (scss2-mode-test--face "true") 'font-lock-constant-face))
      (should (eq (scss2-mode-test--face "not") 'font-lock-constant-face))
      (should (eq (scss2-mode-test--face "silent") 'font-lock-warning-face)))))

(ert-deftest scss2-mode-literal-children-retain-specific-faces ()
  (dolist (mode '(css2-mode scss2-mode))
    (with-temp-buffer
      (insert ".a { content: \"a\\41 b\"; --tokens: [foo]; --escaped: \"c\\42 d\"; /* comment */ }")
      (let ((css-fontify-colors nil))
        (funcall mode)
        (font-lock-mode 1)
        (font-lock-ensure)
        (should-not (treesit-node-check (scss2--root-node) 'has-error))
        (dolist (text '("\\41 " "\\42 "))
          (should (eq (scss2-mode-test--face text) 'font-lock-escape-face)))
        (dolist (text '("[" "]"))
          (should (eq (scss2-mode-test--face text) 'font-lock-bracket-face)))
        (should (eq (scss2-mode-test--face "a\\41") 'font-lock-string-face))
        (should (eq (scss2-mode-test--face "foo") 'font-lock-constant-face))
        (should (eq (scss2-mode-test--face "comment") 'font-lock-comment-face))))))

(ert-deftest scss2-mode-css-nested-values-retain-identifier-faces ()
  (with-temp-buffer
    (insert ".a { animation-name: true, not, null; token: ordinary(true, not, null); fallback: var(--tokens, true not null); list: [true not null]; }")
    (let ((css-fontify-colors nil)
          (case-fold-search nil))
      (css2-mode)
      (font-lock-mode 1)
      (font-lock-ensure)
      (should-not (treesit-node-check (scss2--root-node) 'has-error))
      (goto-char (point-min))
      (while (re-search-forward "\\_<\\(?:true\\|not\\|null\\)\\_>" nil t)
        (should (eq (get-text-property (match-beginning 0) 'face)
                    'font-lock-constant-face))))))

(ert-deftest scss2-mode-important-and-quoted-keyframes-preserve-child-faces ()
  (dolist (mode '(css2-mode scss2-mode))
    (with-temp-buffer
      (insert ".a { --x: red !/**/important; }\n@keyframes \"fa\\64 e\" { from { opacity: 0; } }")
      (let ((css-fontify-colors nil))
        (funcall mode)
        (font-lock-mode 1)
        (font-lock-ensure)
        (should-not (treesit-node-check (scss2--root-node) 'has-error))
        (dolist (role '(("red" . font-lock-constant-face)
                        ("!" . font-lock-keyword-face)
                        ("important" . font-lock-keyword-face)
                        ("/**/" . font-lock-comment-face)
                        ("fa" . font-lock-string-face)
                        ("\\64 " . font-lock-escape-face)))
          (ert-info ((format "%s: %s" mode (car role)))
            (should (eq (scss2-mode-test--face (car role)) (cdr role)))))))))

(ert-deftest scss2-mode-query-words-retain-operator-faces ()
  (dolist (mode '(css2-mode scss2-mode))
    (with-temp-buffer
      (insert "@media not screen and (width > 10px) { .a { color: red; } }\n@supports not (display: grid) { .b { color: blue; } }")
      (let ((css-fontify-colors nil)
            (case-fold-search nil))
        (funcall mode)
        (font-lock-mode 1)
        (font-lock-ensure)
        (should-not (treesit-node-check (scss2--root-node) 'has-error))
        (goto-char (point-min))
        (while (re-search-forward "\\_<\\(?:not\\|and\\)\\_>" nil t)
          (ert-info ((format "%s: %s at %d" mode (match-string 0) (match-beginning 0)))
            (should (eq (get-text-property (match-beginning 0) 'face)
                        'font-lock-operator-face))))))))

(ert-deftest scss2-mode-scss-nested-interpolation-retains-descendant-faces ()
  (with-temp-buffer
    (insert "$x: 2; .a { content: \"#{math.max($x, 1px)}\"; --raw: #{math.max($x, 1px)}; /* #{math.max($x, 1px)} */ }")
    (let ((css-fontify-colors nil)
          (case-fold-search nil))
      (scss2-mode)
      (font-lock-mode 1)
      (font-lock-ensure)
      (should-not (treesit-node-check (scss2--root-node) 'has-error))
      (should (= (length (treesit-query-capture
                         (scss2--root-node) '((interpolation) @expression))) 3))
      (dolist (role '(("$x" . font-lock-variable-name-face)
                      ("math" . font-lock-type-face)
                      ("max" . font-lock-function-name-face)
                      ("1" . font-lock-number-face)
                      ("px" . font-lock-type-face)))
        (goto-char (point-min))
        (while (search-forward (car role) nil t)
          (should (eq (get-text-property (match-beginning 0) 'face) (cdr role))))))))

(ert-deftest scss2-mode-contextual-keys-preserve-comments-and-interpolation ()
  (with-temp-buffer
    (insert "$x: a; $m: (foo/**/#{$x}: red, bar/* note #{$literal} */#{$x}: blue);")
    (let ((css-fontify-colors nil))
      (scss2-mode)
      (font-lock-mode 1)
      (font-lock-ensure)
      (should-not (treesit-node-check (scss2--root-node) 'has-error))
      (dolist (role '(("foo" . css-property)
                      ("bar" . css-property)
                      ("/**/" . font-lock-comment-face)
                      ("note" . font-lock-comment-face)
                      ("#{$literal}" . font-lock-comment-face)
                      ("$literal" . font-lock-comment-face)))
        (should (eq (scss2-mode-test--face (car role)) (cdr role)))))
    (goto-char (point-min))
    (while (search-forward "$x" nil t)
      (should (eq (get-text-property (match-beginning 0) 'face)
                  'font-lock-variable-name-face)))
    (goto-char (point-min))
    (while (search-forward "#{$x}" nil t)
      (should (eq (get-text-property (match-beginning 0) 'face)
                  'font-lock-escape-face)))))

(ert-deftest scss2-mode-keyword-subroles-and-parameters-use-emacs-faces ()
  (with-temp-buffer
    (insert "@use \"colors\" as palette;\n"
            "@mixin paint($tone) { color: $tone !important; }\n"
            "@function f($x) { @if $x { @return $x; } @else { @error \"missing\"; } }\n"
            "@for $i from 1 through 2 { @debug $i; }\n"
            "@media (width > 1px) { .a { --tone: red; color: var(--tone); @include paint($tone: blue); } }")
    (let ((css-fontify-colors nil)) (scss2-mode))
    (font-lock-ensure)
    (should-not (treesit-node-check (scss2--root-node) 'has-error))
    (dolist (text '("@use" "as palette" "@mixin" "!important" "@function"
                    "@if" "@return" "@else" "@error" "@for" "from"
                    "through" "@debug" "@media" "@include"))
      (ert-info ((format "Keyword role: %s" text))
        (should (eq (scss2-mode-test--face text) 'font-lock-keyword-face))))
    (goto-char (point-min))
    (while (re-search-forward "\\$[[:alpha:]]+\\|--tone" nil t)
      (should (eq (get-text-property (match-beginning 0) 'face)
                  'font-lock-variable-name-face)))))

(ert-deftest scss2-mode-custom-names-preserve-interpolation-faces ()
  (with-temp-buffer
    (insert "$tone: red; .a { --#{$tone}: 1px; color: var(--#{$tone}); }")
    (let ((css-fontify-colors nil)) (scss2-mode))
    (font-lock-ensure)
    (should-not (treesit-node-check (scss2--root-node) 'has-error))
    (goto-char (point-min))
    (while (search-forward "--" nil t)
      (should (eq (get-text-property (match-beginning 0) 'face)
                  'font-lock-variable-name-face)))
    (goto-char (point-min))
    (while (search-forward "#{" nil t)
      (should (eq (get-text-property (match-beginning 0) 'face)
                  'font-lock-escape-face)))))

(ert-deftest scss2-mode-contextual-key-faces-survive-incremental-edits ()
  (with-temp-buffer
    ;; Batch mode and hidden buffers otherwise disable the real JIT hooks.
    (rename-buffer "scss2-fontify-incremental-test" t)
    (insert "$x: a; $m: (foo: red);")
    (let ((css-fontify-colors nil)
          (suffix "/* note #{$literal} */#{$x}"))
      (scss2-mode)
      (let ((noninteractive nil)) (font-lock-mode 1))
      (should (eq font-lock-ensure-function #'jit-lock-fontify-now))
      (font-lock-ensure)
      (should (eq (scss2-mode-test--face "foo") 'css-property))
      (goto-char (point-min))
      (search-forward "foo")
      (let ((start (point)))
        (insert suffix)
        (font-lock-ensure (line-beginning-position) (line-end-position))
        (should-not (treesit-node-check (scss2--root-node) 'has-error))
        (should (eq (scss2-mode-test--face "foo") 'css-property))
        (should (eq (scss2-mode-test--face "note") 'font-lock-comment-face))
        (should (eq (scss2-mode-test--face "#{$literal}") 'font-lock-comment-face))
        (should (eq (scss2-mode-test--face "$literal") 'font-lock-comment-face))
        (goto-char (point-min))
        (while (search-forward "$x" nil t)
          (should (eq (get-text-property (match-beginning 0) 'face)
                      'font-lock-variable-name-face)))
        (goto-char (point-min))
        (while (search-forward "#{$x}" nil t)
          (should (eq (get-text-property (match-beginning 0) 'face)
                      'font-lock-escape-face)))
        (delete-region start (+ start (length suffix)))
        (goto-char start)
        (font-lock-ensure (line-beginning-position) (line-end-position))
        (should-not (treesit-node-check (scss2--root-node) 'has-error))
        (should (eq (scss2-mode-test--face "foo") 'css-property))
        (should (eq (scss2-mode-test--face "red") 'font-lock-constant-face))))))

(ert-deftest scss2-mode-css-literal-openers-preserve-following-declarations ()
  (with-temp-buffer
    (insert "/* #{ */\n.a { content: \"#{\"; --raw: #{}; color: red; }")
    (css2-mode)
    (should-not (treesit-node-check (scss2--root-node) 'has-error))
    (should (= (length (treesit-query-capture
                       (scss2--root-node)
                       '((property_declaration) @property))) 3))))

(ert-deftest scss2-mode-dialects-preserve-distinct-string-boundaries ()
  (with-temp-buffer
    (insert ".a{content:\"#{foo\";other:\"bar}\";} .b{color:red;}")
    (css2-mode)
    (should-not (treesit-node-check (scss2--root-node) 'has-error))
    (should (= (length (treesit-query-capture
                       (scss2--root-node)
                       '((property_declaration) @property))) 3))
    (should-not (treesit-query-capture (scss2--root-node)
                                      '((interpolation) @expression)))
    (goto-char (point-min)) (search-forward "foo")
    (scss2-empty-value)
    (should (equal (buffer-string) ".a{content:;other:\"bar}\";} .b{color:red;}")))
  (dolist (expression '("#{not \"a\"}" "#{\"a\" \"b\"}" "#{\";\"}" "#{\"}text\"}"))
    (with-temp-buffer
      (insert ".a { content: \"" expression "\"; color: red; }")
      (scss2-mode)
      (should-not (treesit-node-check (scss2--root-node) 'has-error))
      (should (equal (mapcar (lambda (node) (treesit-node-text node t))
                            (treesit-query-capture
                             (scss2--root-node) '((interpolation) @expression)
                             nil nil t))
                     (list expression))))))

(ert-deftest scss2-mode-interleaved-buffers-retain-dialect ()
  (with-temp-buffer
    (insert ".a { content: \"#{$color}\"; --value: #{$color}; }")
    (css2-mode)
    (let ((css-buffer (current-buffer)))
      (with-temp-buffer
        (insert-buffer-substring css-buffer)
        (scss2-mode)
        (dotimes (_ 3)
          (should (= (length (treesit-query-capture
                             (scss2--root-node) '((interpolation) @expression))) 2))
          (should (= (length (treesit-parser-list)) 1))
          (with-current-buffer css-buffer
            (should-not (treesit-query-capture
                         (scss2--root-node) '((interpolation) @expression)))
            (should (= (length (treesit-parser-list)) 1))))))))

(ert-deftest scss2-mode-completion-owner-survives-emmet-hook ()
  (with-temp-buffer
    (css2-mode)
    (add-hook 'completion-at-point-functions 'emmet2-capf -50 t)
    (run-hooks 'emmet2-mode-hook)
    (should-not (memq 'emmet2-capf completion-at-point-functions))
    (should-not (memq 'css-completion-at-point completion-at-point-functions))
    (should (= (cl-count 'scss2-completion-at-point completion-at-point-functions) 1))))

(ert-deftest scss2-mode-tab-precedes-frontend-bindings-only-in-stylesheets ()
  (dolist (mode '(css2-mode scss2-mode))
    (dolist (key '("TAB" "<tab>"))
      (save-window-excursion
        (with-temp-buffer
          (set-window-buffer (selected-window) (current-buffer))
          (insert ".a { width: calc(2px); color: red; }")
          (funcall mode)
          (goto-char (point-min)) (search-forward "2px")
          (let* ((calls 0)
                 (frontend (make-sparse-keymap))
                 (minor-mode-overriding-map-alist
                  (list (cons t frontend))))
            (define-key frontend (kbd key)
                        (lambda () (interactive) (setq calls (1+ calls))))
            (should (eq (key-binding (kbd key)) #'scss2-tab))
            (execute-kbd-macro (kbd key))
            (should (looking-at " color: red; }"))
            (should (= calls 0))
            ;; After the terminator and in a property name, delegate TAB.
            (execute-kbd-macro (kbd key))
            (should (= calls 1))
            (goto-char (point-min)) (search-forward "width")
            (execute-kbd-macro (kbd key))
            (should (= calls 2))
            (fundamental-mode)
            (should-not (eq (key-binding (kbd key)) #'scss2-tab))))))))

(ert-deftest scss2-mode-tab-remapping-preserves-other-frontend-keys ()
  (dolist (mode '(css2-mode scss2-mode))
    (dolist (command '(yas-next-field yas-next-field-or-maybe-expand
                       company-complete-common-or-cycle))
      (dolist (key '("TAB" "<tab>"))
        (save-window-excursion
          (with-temp-buffer
            (set-window-buffer (selected-window) (current-buffer))
            (insert ".a { width: calc(2px); color: red; }")
            (funcall mode)
            (goto-char (point-min)) (search-forward "2px")
            (let* ((position (point)) (calls 0)
                   (frontend (make-sparse-keymap))
                   (overriding-terminal-local-map frontend))
              (define-key frontend (kbd key) command)
              (define-key frontend (kbd "C-c n") command)
              (cl-letf (((symbol-function command)
                         (lambda () (interactive) (setq calls (1+ calls)))))
                (execute-kbd-macro (kbd "C-c n"))
                (should (= calls 1))
                (should (= (point) position))
                (execute-kbd-macro (kbd key))
                (should (= calls 1))
                (should (looking-at " color: red; }"))))))))))

