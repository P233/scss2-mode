      (call-interactively #'scss2-tab)
      (should (eq (char-before) ?\;)))))

(ert-deftest scss2-corfu-property-searches-once-per-edit ()
  (dolist (scss2-corfu--mode '(css2-mode scss2-mode))
    (scss2-corfu--with "m"
      (let ((search (symbol-function 'emmet2-css-search)) (calls 0))
        (cl-letf (((symbol-function 'emmet2-css-search)
                   (lambda (&rest args) (cl-incf calls) (apply search args))))
          (corfu-auto--complete-deferred)
          (should completion-in-region-mode)
          (should (= calls 1))
          (dolist (event '(?a ?r delete delete))
            (setq calls 0)
            (if (eq event 'delete) (delete-char -1) (insert event))
            (let ((this-command (if (eq event 'delete) 'delete-backward-char 'self-insert-command)))
              (corfu--post-command))
            (should completion-in-region-mode)
            (should (= calls 1))))))))

(ert-deftest scss2-corfu-input-interruption-keeps-the-same-table ()
  (dolist (scss2-corfu--mode '(css2-mode scss2-mode))
    (dolist (target '(emmet2-capf--current-p emmet2-insert-snapshot emmet2-capf--choices emmet2-capf--analyze))
      (scss2-corfu--with "m"
        (corfu-auto--complete-deferred)
        (let ((table (nth 2 completion-in-region--data))
              (original (symbol-function target)) (armed t) (interruptions 0))
          (cl-letf (((symbol-function target)
                     (lambda (&rest args)
                       (when (and armed throw-on-input)
                         (setq armed nil) (cl-incf interruptions) (throw throw-on-input t))
                       (apply original args)))
                    ((symbol-function 'corfu--popup-hide)
                     (lambda () (ert-fail "Input cancellation must keep the popup"))))
            (dolist (key '(?a ?r))
              (insert key)
              (let ((this-command 'self-insert-command)) (corfu--post-command))
              (should completion-in-region-mode)
              (should (eq table (nth 2 completion-in-region--data))))
            (should (= interruptions 1))
            (should (equal (car corfu--candidates) "mar"))))))))

(ert-deftest scss2-corfu-semantic-continuation-does-not-rescan-definitions ()
  (scss2-corfu--with "color: $to"
    (save-excursion (goto-char (point-min)) (insert "$token: red; "))
    (let ((collect (symbol-function 'scss2-completion--candidates)) (calls 0))
      (cl-letf (((symbol-function 'scss2-completion--candidates)
                 (lambda (&rest args) (cl-incf calls) (apply collect args))))
        (corfu-auto--complete-deferred)
        (should completion-in-region-mode)
        (dolist (edit '(?k delete))
          (if (eq edit 'delete) (delete-char -1) (insert edit))
          (let ((this-command (if (eq edit 'delete) 'delete-backward-char 'self-insert-command)))
            (corfu--post-command))
          (should completion-in-region-mode)
          (should (member "$token" corfu--candidates)))
        (should (= calls 1))))))

(ert-deftest scss2-corfu-closed-module-is-read-once-per-session ()
  (let* ((directory (make-temp-file "scss2-corfu-module-" t))
         (path (expand-file-name "_tokens.scss" directory)))
    (unwind-protect
        (progn
          (with-temp-file path (insert "$token: red;"))
          (scss2-corfu--with "color: tokens.$to"
            (setq buffer-file-name (expand-file-name "main.scss" directory))
            (save-excursion (goto-char (point-min)) (insert "@use 'tokens'; "))
            (undo-boundary)
            (let ((collect (symbol-function 'scss2-completion--module-names)) (calls 0))
              (cl-letf (((symbol-function 'scss2-completion--module-names)
                         (lambda (&rest args) (cl-incf calls) (apply collect args))))
                (corfu-auto--complete-deferred)
                (should completion-in-region-mode)
                ;; Candidate strings must survive disposal of the temporary tree.
                (garbage-collect)
                (dolist (edit '(?k delete))
                  (if (eq edit 'delete) (delete-char -1) (insert edit))
                  (let ((this-command (if (eq edit 'delete) 'delete-backward-char 'self-insert-command)))
                    (corfu--post-command))
                  (should completion-in-region-mode)
                  (should (member "$token" corfu--candidates)))
                (should (= calls 1))
                (should-not (find-buffer-visiting path))
                (let ((source (buffer-string)))
                  (undo-boundary)
                  (corfu--goto (cl-position "$token" corfu--candidates :test #'equal))
                  (let ((this-command 'corfu-insert) (last-command nil)) (corfu-insert))
                  (should (equal (buffer-string) "@use 'tokens'; .a { color: tokens.$token }"))
                  (undo-boundary)
                  (undo-only 1)
                  (should (equal (buffer-string) source)))
                (corfu-quit)
                (with-temp-file path (insert "$toast: blue;"))
                (corfu-auto--complete-deferred)
                (should (member "$toast" corfu--candidates))
                (should-not (member "$token" corfu--candidates))
                (should (= calls 2))))))
      (delete-directory directory t))))

