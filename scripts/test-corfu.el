;; Run after Emmet's test/bootstrap.el, with this checkout on load-path.
;; Uses the dependency's pinned Corfu and YAS; only popup drawing is stubbed.

(require 'ert)
(require 'scss2-mode)
(require 'corfu)
(require 'corfu-auto)
(require 'yasnippet)
(setq native-comp-enable-subr-trampolines nil)
(defvar scss2-corfu--temporary (make-temp-file "scss2-corfu-" t))
(setq scss2-grammar-cache-directory scss2-corfu--temporary)
(defvar scss2-corfu--mode #'scss2-mode)

(defmacro scss2-corfu--with (input &rest body)
  (declare (indent 1) (debug t))
  `(save-window-excursion
     (with-temp-buffer
       (set-window-buffer (selected-window) (current-buffer))
       (funcall scss2-corfu--mode) (insert ".a { " ,input " }") (backward-char 2)
       (buffer-enable-undo)
       (let ((completion-styles '(basic partial-completion))
             ;; Only this package's own category default stays in effect.
             (completion-category-defaults '((scss2 (styles scss2))))
             (completion-category-overrides nil)
             (corfu-auto-prefix 1) (corfu-auto-trigger nil)
             (corfu-on-exact-match 'show) (corfu-preview-current nil)
             (last-command-event ?a))
         (cl-letf (((symbol-function 'corfu--popup-show) #'ignore)
                   ((symbol-function 'corfu--popup-hide) #'ignore)
                   ((symbol-function 'corfu--protect) #'funcall))
           (unwind-protect (progn ,@body)
             (when completion-in-region-mode (corfu-quit))))))))

(ert-deftest scss2-corfu-declaration-before-a-separated-nested-rule ()
  (dolist (command '(automatic emmet2-complete))
    (scss2-corfu--with ""
      (corfu-mode 1)
      (erase-buffer)
      (insert ".appShell {\n  position: relative;\n  display: flex;\n  width: 100vw;\n  height: 100vh;\n  overflow: hidden; |\n\n  &[data-is-resizing] {\n    cursor: col-resize;\n    user-select: none;\n  }\n}")
      (search-backward "|") (delete-char 1)
      (insert "o")
      (if (eq command 'automatic) (corfu-auto--complete-deferred)
        (emmet2-complete))
      (should completion-in-region-mode)
      (let ((table (nth 2 completion-in-region--data)))
        (cl-letf (((symbol-function 'corfu--popup-hide)
                   (lambda () (ert-fail "An unfinished declaration must keep its popup"))))
          (dolist (part '("." "5"))
            (insert part)
            (let ((this-command 'self-insert-command)) (corfu--post-command))
            (should completion-in-region-mode)
            (should (eq table (nth 2 completion-in-region--data)))))
        (let ((before (buffer-string)))
          (corfu-insert)
          (should (equal (buffer-string) (string-replace "o.5" "opacity: 0.5;" before)))
          (undo-only 1)
          (should (equal (buffer-string) before)))))))

(ert-deftest scss2-corfu-declaration-before-an-adjacent-nested-rule ()
  (dolist (scss2-corfu--mode '(css2-mode scss2-mode))
    (dolist (command '(automatic emmet2-complete))
      (scss2-corfu--with ""
        (corfu-mode 1)
        (erase-buffer)
        (insert ".a {\n  text-align: center;\n  |\n  &[data-is-resizing] { cursor: col-resize; }\n}")
        (search-backward "|") (delete-char 1)
        (insert "m")
        (if (eq command 'automatic) (corfu-auto--complete-deferred)
          (emmet2-complete))
        (should completion-in-region-mode)
        (let ((table (nth 2 completion-in-region--data)))
          (cl-letf (((symbol-function 'corfu--popup-hide)
                     (lambda () (ert-fail "The declaration must keep its popup"))))
            (dolist (char '(?1 ?0))
              (insert char)
              (let ((this-command 'self-insert-command)) (corfu--post-command))
              (should completion-in-region-mode)
              (should (eq table (nth 2 completion-in-region--data)))))
          (let ((before (buffer-string)))
            (corfu--goto 0)
            (execute-kbd-macro (kbd "TAB"))
            (should-not completion-in-region-mode)
            (should (equal (buffer-string) (string-replace "m10" "margin: 10px;\n  " before)))
            (should (looking-at "\n  &"))
            (should (= (current-column) 2))
            (undo-only 1)
            (should (equal (buffer-string) before))))))))

(ert-deftest scss2-corfu-separated-selectors-do-not-start-declaration-completion ()
  (dolist (scss2-corfu--mode '(css2-mode scss2-mode))
    (dolist (selector '("a[href]" "div.card" "svg|path" "div>span" "div~span"))
      (scss2-corfu--with selector
        (save-excursion (insert "\n\n.child {}"))
        (let ((before (buffer-string)) (position (point)))
          (should-not (scss2-completion-at-point))
          (corfu-auto--complete-deferred)
          (should-not completion-in-region-mode)
          (should-error (scss2-expand) :type 'user-error)
          (should (equal (buffer-string) before))
          (should (= (point) position)))))))

(ert-deftest scss2-corfu-raw-values-before-a-separated-nested-rule ()
  (dolist (scss2-corfu--mode '(css2-mode scss2-mode))
    (dolist (entry '(("p[1px]" . "padding: 1px;")
                     ("w[calc(100%-2rem)]" . "width: calc(100%-2rem);")
                     ("ct['foo.bar']" . "content: 'foo.bar';")
                     ("ct['>']" . "content: '>';")))
