(ert-deftest scss2-corfu-declaration-punctuation-keeps-the-same-session ()
  (dolist (case '(("o" ".5" "opacity: 0.5;")
                  ("m" "-.5" "margin: -0.5rem;")
                  ("w" "10%" "width: 10%;")
                  ("c" "#fff" "color: #fff;")
                  ("p" "$-gutter" "padding: $-gutter;")
                  ("p" "$gutter_size" "padding: $gutter_size;")
                  ("m" "--gap" "margin: var(--gap);")
                  ("p" "!" "padding: !important;")
                  ("m" ",p" "margin: ;\n     padding: ;")
                  ("m" "+p" "margin: ;\n     padding: ;")))
    (dolist (following '("" "\n\n  &[data-is-resizing] { cursor: col-resize; }"))
      (ert-info ((format "%S before %S" case following))
        (scss2-corfu--with (car case)
          (save-excursion (insert following))
          (corfu-auto--complete-deferred)
          (should completion-in-region-mode)
          (let ((table (nth 2 completion-in-region--data)))
            (cl-letf (((symbol-function 'corfu--popup-hide)
                       (lambda () (ert-fail "Declaration punctuation must not hide the popup"))))
              (dolist (char (string-to-list (cadr case)))
                (insert char)
                (let ((this-command 'self-insert-command)) (corfu--post-command))
                (should completion-in-region-mode)
                (should (eq table (nth 2 completion-in-region--data)))))
            (corfu-insert)
            (should (equal (buffer-string) (concat ".a { " (nth 2 case) following " }")))))))))

(ert-deftest scss2-corfu-declaration-boundaries-still-end-the-session ()
  ;; Unclosed groups have no current expansion either; old rows must not linger.
  (dolist (suffix '(";" " " "}" ":" "/*" "//" "[" "("))
    (ert-info (suffix)
      (scss2-corfu--with "o"
        (corfu-auto--complete-deferred)
        (should completion-in-region-mode)
        (let ((old (car corfu--candidates))
              (exit (plist-get (nth 4 completion-in-region--data) :exit-function)))
          (insert suffix)
          (let ((this-command 'self-insert-command)) (corfu--post-command))
          (should-not completion-in-region-mode)
          (let ((before (buffer-string)))
            (funcall exit old 'finished)
            (should (equal (buffer-string) before))))))))

(ert-deftest scss2-corfu-typing-selecting-and-undo ()
  (scss2-corfu--with "d"
    (corfu-auto--complete-deferred)
    (should completion-in-region-mode)
    (insert "is")
    (let ((this-command 'self-insert-command)) (corfu--post-command))
    (let* ((rows (cdr (corfu--affixate corfu--candidates)))
           (index (cl-position "display: flex;" (mapcar #'cadr rows) :test #'equal)))
      (should index)
      (should (equal (buffer-string) ".a { dis }"))
      (corfu--goto index)
      (let ((this-command 'corfu-insert) (last-command nil)) (corfu-insert))
      (should (equal (buffer-string) ".a { display: flex; }"))
      (undo-only 1)
      (should (equal (buffer-string) ".a { dis }")))))

(defun scss2-corfu--idle-away ()
  "Run idle resource release while the current test buffer is invisible."
  (let ((buffer (current-buffer))
        (other (generate-new-buffer "scss2-corfu-idle-away")))
    (unwind-protect
        (progn
          (set-window-buffer (selected-window) other)
          (cl-letf (((symbol-function 'input-pending-p) (lambda () nil)))
            (scss2--release-idle-buffers)))
      (set-window-buffer (selected-window) buffer)
      (kill-buffer other))))

(ert-deftest scss2-corfu-idle-release-preserves-session-and-next-acceptance ()
  (dolist (scss2-corfu--mode '(css2-mode scss2-mode))
    (scss2-corfu--with "display: fl"
      (corfu-auto--complete-deferred)
      (should completion-in-region-mode)
      (let ((table (nth 2 completion-in-region--data)) (root (scss2--root-node)))
        (scss2-corfu--idle-away)
        (should completion-in-region-mode)
        (should (eq table (nth 2 completion-in-region--data)))
        (should-not (treesit-node-check root 'outdated))
        (corfu-quit)
        (scss2-corfu--idle-away)
        (should (treesit-node-check root 'outdated)))
      (corfu-auto--complete-deferred)
      (should (member "flex" corfu--candidates))
      (corfu--goto (cl-position "flex" corfu--candidates :test #'equal))
      (let ((this-command 'corfu-insert) (last-command nil)) (corfu-insert))
      (should (equal (buffer-string) ".a { display: flex }"))
      (undo-boundary)
      (undo-only 1)
      (should (equal (buffer-string) ".a { display: fl }")))))

(ert-deftest scss2-corfu-idle-release-preserves-snippet-fields-and-tab ()
  (dolist (scss2-corfu--mode '(css2-mode scss2-mode))
    (scss2-corfu--with ""
      (yas-minor-mode 1)
