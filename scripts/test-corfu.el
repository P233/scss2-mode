;; SPDX-License-Identifier: GPL-3.0-or-later
;; Run after Emmet's test/bootstrap.el, with this checkout on load-path.
;; Uses the dependency's pinned Corfu and YAS; only popup drawing is stubbed.

(require 'ert)
(require 'scss2-mode)
(require 'corfu)
(require 'corfu-auto)
(require 'yasnippet)
(setq native-comp-enable-subr-trampolines nil)
(defvar scss2-corfu--temporary (make-temp-file "scss2-corfu-" t))
(setq scss2-grammar-cache-directory scss2-corfu--temporary)
(defvar scss2-corfu--mode #'scss2-mode)

(defmacro scss2-corfu--with (input &rest body)
  (declare (indent 1) (debug t))
  `(save-window-excursion
     (with-temp-buffer
       (set-window-buffer (selected-window) (current-buffer))
       (funcall scss2-corfu--mode) (insert ".a { " ,input " }") (backward-char 2)
       (buffer-enable-undo)
       (let ((completion-styles '(basic partial-completion))
             ;; Only this package's own category default stays in effect.
             (completion-category-defaults '((scss2 (styles scss2))))
             (completion-category-overrides nil)
             (corfu-auto-prefix 1) (corfu-auto-trigger nil)
             (corfu-on-exact-match 'show) (corfu-preview-current nil)
             (last-command-event ?a))
         (cl-letf (((symbol-function 'corfu--popup-show) #'ignore)
                   ((symbol-function 'corfu--popup-hide) #'ignore)
                   ((symbol-function 'corfu--protect) #'funcall))
           (unwind-protect (progn ,@body)
             (when completion-in-region-mode (corfu-quit))))))))

(ert-deftest scss2-corfu-typing-selecting-and-undo ()
  (scss2-corfu--with "d"
    (corfu-auto--complete-deferred)
    (should completion-in-region-mode)
    (insert "is")
    (let ((this-command 'self-insert-command)) (corfu--post-command))
    (let* ((rows (cdr (corfu--affixate corfu--candidates)))
           (index (cl-position "display: flex;" (mapcar #'cadr rows) :test #'equal)))
      (should index)
      (should (equal (buffer-string) ".a { dis }"))
      (corfu--goto index)
      (let ((this-command 'corfu-insert) (last-command nil)) (corfu-insert))
      (should (equal (buffer-string) ".a { display: flex; }"))
      (undo-only 1)
      (should (equal (buffer-string) ".a { dis }")))))

(ert-deftest scss2-corfu-declaration-field-and-value-handoff ()
  (scss2-corfu--with "dis"
    (corfu-auto--complete-deferred)
    (let ((this-command 'corfu-insert)) (corfu-insert))
    (should (equal (buffer-string) ".a { display: ; }"))
    (should-not (yas-active-snippets))
    (should (eq (char-after) ?\;))
    (insert "fl")
    (corfu-auto--complete-deferred)
    (should (member "flex" corfu--candidates))
    (corfu--goto (cl-position "flex" corfu--candidates :test #'equal))
    (corfu-insert)
    (should (equal (buffer-string) ".a { display: flex; }"))
    (call-interactively (key-binding (kbd "TAB")))
    (should (eq (char-before) ?\;))
    (should-not (yas-active-snippets))))

(ert-deftest scss2-corfu-typed-colon-releases-old-table ()
  (scss2-corfu--with "display"
    (corfu-auto--complete-deferred)
    (insert ": fl")
    (let ((this-command 'self-insert-command)) (corfu--post-command))
    (corfu-auto--complete-deferred)
    (should completion-in-region-mode)
    (should (member "flex" corfu--candidates))
    (should (equal (buffer-string) ".a { display: fl }"))))

(ert-deftest scss2-corfu-fuzzy-value-uses-the-category-style ()
  (scss2-corfu--with "display: ib"
    (corfu-auto--complete-deferred)
    (should completion-in-region-mode)
    (should (equal (car corfu--candidates) "inline-block"))
    (corfu--goto 0)
    (let ((this-command 'corfu-insert)) (corfu-insert))
    (should (equal (buffer-string) ".a { display: inline-block }"))))

(ert-deftest scss2-corfu-value-initials-in-both-dialects ()
  (dolist (scss2-corfu--mode '(css2-mode scss2-mode))
    (scss2-corfu--with "display: if"
      (corfu-auto--complete-deferred)
      (should (equal (car corfu--candidates) "inline-flex"))
      (corfu--goto 0) (corfu-insert) (undo-boundary)
      (should (equal (buffer-string) ".a { display: inline-flex }"))
      (undo-only 1)
      (should (equal (buffer-string) ".a { display: if }")))))

(ert-deftest scss2-corfu-function-cursor-and-host-tab-without-snippet-fields ()
  (dolist (scss2-corfu--mode '(css2-mode scss2-mode))
    (scss2-corfu--with "w"
      (corfu-auto--complete-deferred)
      (let* ((rows (cdr (corfu--affixate corfu--candidates)))
             (index (cl-position "width: ;" (mapcar #'cadr rows) :test #'equal)))
        (should index) (corfu--goto index) (corfu-insert))
      (should-not (yas-active-snippets))
      (insert "cal") (corfu-auto--complete-deferred)
      (corfu--goto (cl-position "calc()" corfu--candidates :test #'equal))
      (corfu-insert)
      (should (looking-at ");"))
      (should-not (yas-active-snippets))
      (insert "100% - 1rem")
      (call-interactively (key-binding (kbd "TAB")))
      (run-hooks 'post-command-hook)
      (should (eq (char-before) ?\;))
      (should-not mark-active)
      (should-not (yas-active-snippets))
      (should (equal (buffer-string) ".a { width: calc(100% - 1rem); }"))
      (delete-backward-char 1)
      (should (equal (buffer-string) ".a { width: calc(100% - 1rem) }")))))

(ert-deftest scss2-corfu-plain-value-tab-jumps-over-semicolon ()
  (dolist (scss2-corfu--mode '(css2-mode scss2-mode))
    (scss2-corfu--with "display: ib;"
      (backward-char)
      (corfu-auto--complete-deferred)
      (corfu--goto (cl-position "inline-block" corfu--candidates :test #'equal))
      (should (eq (key-binding (kbd "TAB")) #'scss2-tab))
      (call-interactively (key-binding (kbd "TAB")))
      (should-not completion-in-region-mode)
      (should (eq (char-before) ?\;))
      (should-not mark-active)
      (should (equal (buffer-string) ".a { display: ib; }")))))

(ert-deftest scss2-corfu-declaration-tab-still-accepts-a-choice ()
  (dolist (scss2-corfu--mode '(css2-mode scss2-mode))
    (scss2-corfu--with "m10"
      (corfu-auto--complete-deferred)
      (should completion-in-region-mode)
      (execute-kbd-macro (kbd "TAB"))
      (should (equal (buffer-string) ".a { margin: 10px; }")))))

(ert-deftest scss2-corfu-value-tab-keeps-completion-without-semicolon ()
  (dolist (scss2-corfu--mode '(css2-mode scss2-mode))
    (scss2-corfu--with "display: ib"
      (corfu-auto--complete-deferred)
      (corfu--goto (cl-position "inline-block" corfu--candidates :test #'equal))
      (should (eq (key-binding (kbd "TAB")) #'corfu-complete))
      (execute-kbd-macro (kbd "TAB"))
      (should (equal (buffer-string) ".a { display: inline-block }")))))

(ert-deftest scss2-corfu-tab-leaves-explicit-snippet-value-in-one-step ()
  (dolist (scss2-corfu--mode '(css2-mode scss2-mode))
    (dolist (key '("TAB" "<tab>"))
      (scss2-corfu--with ""
        (yas-minor-mode 1)
        (yas-expand-snippet "width: calc(${1:1rem} + ${2:2px});$0")
        (should (yas-active-snippets))
        (execute-kbd-macro (kbd key))
        (should (eq (char-before) ?\;))
        (should-not mark-active)
        (should (equal (buffer-string) ".a { width: calc(1rem + 2px); }"))))))

(ert-deftest scss2-corfu-snippet-navigation-keeps-non-tab-bindings ()
  (dolist (scss2-corfu--mode '(css2-mode scss2-mode))
    (dolist (command '(yas-next-field yas-next-field-or-maybe-expand))
      (scss2-corfu--with ""
        (yas-minor-mode 1)
        (yas-expand-snippet "width: calc(${1:1rem} + ${2:2px});$0")
        (use-local-map (copy-keymap (current-local-map)))
        (local-set-key (kbd "C-c n") command)
        (execute-kbd-macro (kbd "C-c n"))
        (should (looking-at "2px"))
        (should (yas-active-snippets))
        (should (equal (buffer-string) ".a { width: calc(1rem + 2px); }"))))))

(unwind-protect
    (let ((result (ert-run-tests-batch "^scss2-corfu-")))
      (delete-directory scss2-corfu--temporary t)
      (kill-emacs (if (zerop (ert-stats-completed-unexpected result)) 0 1)))
  (when (file-directory-p scss2-corfu--temporary)
    (delete-directory scss2-corfu--temporary t)))
